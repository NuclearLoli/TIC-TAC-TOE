<Window x:Class="CaroGame.Wpf.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:CaroGame.Wpf.ViewModels"
        xmlns:views="clr-namespace:CaroGame.Wpf.Views"
        xmlns:controls="clr-namespace:CaroGame.Wpf.Controls"
        mc:Ignorable="d"
        Title="Cờ Caro Vô Hạn (.NET 9 WPF)" Height="840" Width="1240"
        MinHeight="680" MinWidth="960"
        WindowStartupLocation="CenterScreen"
        Background="#262421">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="38"
                      ResizeBorderThickness="6"
                      CornerRadius="0"
                      GlassFrameThickness="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <!-- DataTemplates mapping ViewModel to View -->
        <DataTemplate DataType="{x:Type vm:MenuViewModel}">
            <views:MenuView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:GamePlayViewModel}">
            <views:GamePlayView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:HistoryViewModel}">
            <views:HistoryView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ReplayViewModel}">
            <views:ReplayView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:OnlineLobbyViewModel}">
            <views:OnlineLobbyView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AuthViewModel}">
            <views:AuthView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:LeaderboardViewModel}">
            <views:LeaderboardView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ProfileViewModel}">
            <views:ProfileView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:FriendsViewModel}">
            <views:FriendsView />
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="38" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Custom Seamless TitleBar (Chess.com Dark Theme) -->
        <Border Grid.Row="0" Background="#1E1D1B" BorderBrush="#36332E" BorderThickness="0,0,0,1">
            <Grid>
                <!-- Title & Logo (Drag area is the whole title bar except buttons) -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                    <StackPanel Orientation="Horizontal" Margin="0,0,8,0">
                        <TextBlock Text="✕" FontSize="11" FontWeight="Black" Foreground="#EF4444" Margin="0,0,3,0"/>
                        <TextBlock Text="◯" FontSize="11" FontWeight="Black" Foreground="#38BDF8"/>
                    </StackPanel>
                    <TextBlock Text="CỜ CARO" FontWeight="Bold" FontSize="12.5" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Window Control Buttons (Minimize, Maximize, Close) & User Identity -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" WindowChrome.IsHitTestVisibleInChrome="True">
                    <!-- Global User Account / Profile pill -->
                    <Button Command="{Binding OpenProfileOrAuthCommand}" Margin="0,0,14,0" Padding="8,3"
                            Background="#2B2926" BorderBrush="#3F3C38" BorderThickness="1" Cursor="Hand"
                            ToolTip="Hồ sơ cá nhân / Tùy biến tài khoản">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <controls:AvatarControl Avatar="{Binding CurrentUser.Avatar}"
                                                    AvatarIcon="{Binding UserAvatarIcon}"
                                                    Size="22" FontSize="11"
                                                    BorderThickness="1"
                                                    Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding UserFlag}" FontSize="11" Margin="0,0,4,0" VerticalAlignment="Center"
                                       Visibility="{Binding IsLoggedIn, Converter={StaticResource BoolToVis}}" />
                            <TextBlock Text="{Binding UserDisplayName}" FontWeight="SemiBold" FontSize="11.5" Foreground="#E2DFD8" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding UserEloText, StringFormat=' ({0})'}" FontWeight="Bold" FontSize="11" Foreground="#F59E0B"
                                       Visibility="{Binding IsLoggedIn, Converter={StaticResource BoolToVis}}"
                                       VerticalAlignment="Center" Margin="2,0,0,0" />
                        </StackPanel>
                    </Button>

                    <Button Width="44" Height="38" Background="Transparent" BorderThickness="0"
                            Content="—" FontSize="12" Foreground="#9E9C99" Cursor="Hand" Click="Minimize_Click"/>
                    <Button Width="44" Height="38" Background="Transparent" BorderThickness="0"
                            Content="☐" FontSize="12" Foreground="#9E9C99" Cursor="Hand" Click="Maximize_Click"/>
                    <Button Width="44" Height="38" Background="Transparent" BorderThickness="0"
                            Content="✕" FontSize="12" Foreground="#9E9C99" Cursor="Hand" Click="Close_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Shell Dynamic Content -->
        <ContentControl Grid.Row="1" Content="{Binding CurrentView}" />
    </Grid>
</Window>
