<UserControl x:Class="CaroGame.Wpf.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:CaroGame.Wpf.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance vm:SettingsViewModel}"
             d:DesignHeight="700" d:DesignWidth="900">

    <Grid Background="#262421">
        <Border MaxWidth="760" VerticalAlignment="Center" Margin="30"
                Background="#302E2B" BorderBrush="#3F3C38" BorderThickness="1.5"
                CornerRadius="20" Padding="36">
            <Border.Effect>
                <DropShadowEffect BlurRadius="35" Direction="270" ShadowDepth="10" Color="#000000" Opacity="0.5" />
            </Border.Effect>

            <StackPanel>
                <!-- Header -->
                <Grid Margin="0,0,0,20">
                    <TextBlock Text="CÀI ĐẶT ÂM THANH" FontSize="22" FontWeight="Black"
                               Foreground="#FFFFFF" VerticalAlignment="Center" />
                    <Button Content="◀ Quay lại" Command="{Binding BackToMenuCommand}"
                            HorizontalAlignment="Right" Padding="12,6" />
                </Grid>

                <!-- Âm lượng tổng (Master Volume) -->
                <Border Background="#262421" BorderBrush="#3F3C38" BorderThickness="1"
                        CornerRadius="12" Padding="18,14" Margin="0,0,0,20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="60" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Âm lượng:" FontWeight="Bold" FontSize="13.5"
                                   Foreground="#FFFFFF" VerticalAlignment="Center" Margin="0,0,16,0" />
                        <Slider Grid.Column="1" Minimum="0" Maximum="1" Value="{Binding MasterVolume}"
                                VerticalAlignment="Center" SmallChange="0.05" LargeChange="0.1" />
                        <TextBlock Grid.Column="2" Text="{Binding MasterVolume, StringFormat='{}{0:P0}'}"
                                   FontSize="14" FontWeight="Black" Foreground="#81B64C"
                                   HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <Separator Background="#3F3C38" Margin="0,0,0,16" />

                <!-- Danh sách Sound items -->
                <ScrollViewer MaxHeight="350" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding SoundItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:SoundItemViewModel}">
                                <Border Background="#262421" BorderBrush="#3F3C38" BorderThickness="1"
                                        CornerRadius="10" Padding="14,10" Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <CheckBox Grid.Column="0" IsChecked="{Binding IsEnabled}"
                                                  VerticalAlignment="Center" Margin="0,0,14,0" />

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DisplayName}" FontSize="13.5" FontWeight="Bold" Foreground="#FFFFFF" />
                                            <TextBlock Text="{Binding FilePath}" FontSize="11.5" Foreground="#9E9C99" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="▶ Nghe thử" Command="{Binding TestSoundCommand}"
                                                    Padding="10,6" Margin="0,0,6,0" />

                                            <Button Content="📁 Chọn File..." Command="{Binding BrowseFileCommand}"
                                                    Style="{StaticResource AccentBlueButton}"
                                                    Padding="10,6" Margin="0,0,6,0" />

                                            <Button Content="Mặc định" Command="{Binding ResetToDefaultCommand}"
                                                    Padding="8,6" FontSize="12" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Nút Reset All -->
                <Button Content="⟳ Khôi phục toàn bộ về âm thanh mặc định" Command="{Binding ResetAllToDefaultCommand}"
                        HorizontalAlignment="Right" Background="Transparent" Foreground="#FF8282"
                        BorderThickness="0" FontSize="12.5" FontWeight="Bold" Margin="0,14,0,0" Cursor="Hand" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
