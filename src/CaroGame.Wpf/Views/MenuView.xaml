<UserControl x:Class="CaroGame.Wpf.Views.MenuView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:conv="clr-namespace:CaroGame.Wpf.Converters"
             xmlns:controls="clr-namespace:CaroGame.Wpf.Controls"
             xmlns:vm="clr-namespace:CaroGame.Wpf.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance vm:MenuViewModel}"
             d:DesignHeight="820" d:DesignWidth="1160">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:BoolToVisibilityConverter x:Key="InvertedBoolToVisibility" Invert="True" />
    </UserControl.Resources>

    <Grid Background="#262421">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- TOP BAR: Navigation, Logo & Profile Status -->
        <Border Grid.Row="0" Background="#21201D" BorderBrush="#36332E" BorderThickness="0,0,0,1" Padding="18,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Left: Branding -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
                    <Border Background="#3F2727" CornerRadius="8" Width="30" Height="30" Margin="0,0,8,0">
                        <TextBlock Text="✕" FontSize="16" FontWeight="Black" Foreground="#EF4444"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <Border Background="#1E334D" CornerRadius="8" Width="30" Height="30" Margin="0,0,10,0">
                        <TextBlock Text="◯" FontSize="16" FontWeight="Black" Foreground="#38BDF8"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="CỜ CARO ARENA" FontWeight="Black" FontSize="16" Foreground="#FFFFFF" VerticalAlignment="Center" />
                </StackPanel>

                <!-- Center: Quick Navigation Links -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0">
                    <Button Content="👥 Bạn Bè" Command="{Binding OpenFriendsCommand}"
                            Margin="0,0,6,0" Padding="8,5" FontSize="11.5" Background="#302E2B" BorderBrush="#3F3C38"
                            Foreground="#C3C1BE" ToolTip="Danh sách bạn bè &amp; Thách đấu" />
                    <Button Content="🏆 BXH" Command="{Binding OpenLeaderboardCommand}"
                            Margin="0,0,6,0" Padding="8,5" FontSize="11.5" Background="#302E2B" BorderBrush="#3F3C38"
                            Foreground="#C3C1BE" ToolTip="Xem bảng xếp hạng Elo toàn server" />
                    <Button Content="📜 Lịch Sử" Command="{Binding OpenHistoryCommand}"
                            Margin="0,0,6,0" Padding="8,5" FontSize="11.5" Background="#302E2B" BorderBrush="#3F3C38"
                            Foreground="#C3C1BE" ToolTip="Xem lại lịch sử và replay các ván đấu" />
                    <Button Content="⚙️ Cài Đặt" Command="{Binding OpenSettingsCommand}"
                            Padding="8,5" FontSize="11.5" Background="#302E2B" BorderBrush="#3F3C38"
                            Foreground="#C3C1BE" ToolTip="Tùy chỉnh âm lượng và hiệu ứng" />
                </StackPanel>

                <!-- Right: Profile Pill (Authenticated) -->
                <Border Grid.Column="2" VerticalAlignment="Center"
                        Background="#302E2B" BorderBrush="#3F3C38" BorderThickness="1"
                        CornerRadius="12" Padding="8,4">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <controls:AvatarControl Avatar="{Binding CurrentUser.Avatar}"
                                                AvatarIcon="{Binding UserAvatarIcon}"
                                                Size="30" FontSize="14"
                                                BorderBrush="#81B64C" BorderThickness="1.5"
                                                Margin="0,0,8,0" VerticalAlignment="Center" />
                        <StackPanel VerticalAlignment="Center" Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{Binding UserFlag}" FontSize="11" Margin="0,0,4,0" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding UserDisplayName}" FontWeight="Bold" FontSize="12.5" Foreground="#FFFFFF"
                                           MaxWidth="120" TextTrimming="CharacterEllipsis" Margin="0,0,6,0" />
                                <Border Background="#3B3220" BorderBrush="#78591E" BorderThickness="1" CornerRadius="5" Padding="5,1">
                                    <TextBlock Text="{Binding UserEloText}" FontWeight="Black" FontSize="10.5" Foreground="#F59E0B" />
                                </Border>
                            </StackPanel>
                            <TextBlock Text="{Binding UserStatsText}" FontSize="10" Foreground="#9E9C99" Margin="0,2,0,0" />
                        </StackPanel>
                        <Button Content="👤 Hồ Sơ" Command="{Binding OpenProfileCommand}"
                                Padding="7,4" FontSize="11" Margin="0,0,5,0" ToolTip="Xem hồ sơ &amp; Tùy biến tài khoản"
                                Visibility="{Binding IsLoggedIn, Converter={StaticResource BoolToVisibility}}" />
                        <Button Content="Đăng Xuất" Command="{Binding LogoutCommand}"
                                Style="{StaticResource DangerButton}" Padding="7,4" FontSize="11" ToolTip="Đăng xuất tài khoản"
                                Visibility="{Binding IsLoggedIn, Converter={StaticResource BoolToVisibility}}" />
                        <Button Content="🔑 Đăng Nhập" Command="{Binding OpenLoginCommand}"
                                Style="{StaticResource PrimaryButton}" Padding="8,4" FontSize="11" ToolTip="Đăng nhập hoặc đăng ký tài khoản"
                                Visibility="{Binding IsLoggedIn, Converter={StaticResource InvertedBoolToVisibility}}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- MAIN DASHBOARD: 3 DISTINCT CARDS (Responsive Chess.com Grid) -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="20,18,20,18" MaxWidth="1160" HorizontalAlignment="Center">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Sub-Greeting Banner -->
                <StackPanel Grid.Row="0" Margin="0,0,0,20" HorizontalAlignment="Center">
                    <TextBlock Text="CHỌN CHẾ ĐỘ THI ĐẤU" FontSize="22" FontWeight="Black"
                               Foreground="#FFFFFF" HorizontalAlignment="Center" />
                    <TextBlock Text="Thách thức trí tuệ cùng AI Minimax hoặc thi đấu trực tuyến với các kỳ thủ"
                               FontSize="13" Foreground="#9E9C99" HorizontalAlignment="Center" Margin="0,4,0,0" />
                </StackPanel>

                <!-- 3 Action Cards Grid (Responsive, No Rigid MinWidth overlap) -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- CARD 1: ĐẤU VỚI ROBOT (AI) -->
                    <Border Grid.Column="0" Background="#302E2B" BorderBrush="#3F3C38" BorderThickness="1.5"
                            CornerRadius="18" Padding="24,24">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="25" ShadowDepth="6" Direction="270" Color="#000000" Opacity="0.4" />
                        </Border.Effect>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Header -->
                            <StackPanel Grid.Row="0" Margin="0,0,0,16">
                                <Border Width="52" Height="52" CornerRadius="14" Background="#262421" BorderBrush="#3F3C38" BorderThickness="1"
                                        HorizontalAlignment="Left" Margin="0,0,0,12">
                                    <TextBlock Text="🤖" FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="ĐẤU VỚI ROBOT" FontSize="18" FontWeight="Black" Foreground="#FFFFFF" />
                                <TextBlock Text="Luyện tập chiến thuật cùng AI đa cấp độ" FontSize="12.5" Foreground="#9E9C99" Margin="0,4,0,0" />
                            </StackPanel>

                            <!-- Options -->
                            <StackPanel Grid.Row="1" Margin="0,0,0,20">
                                <!-- Độ Khó -->
                                <TextBlock Text="ĐỘ KHÓ ROBOT" FontSize="11" FontWeight="Bold" Foreground="#9E9C99" Margin="2,0,0,6" />
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <RadioButton Grid.Column="0" Style="{StaticResource SegmentButton}"
                                                 Content="Dễ" IsChecked="{Binding IsEasy}" GroupName="AiDiffMenu" />
                                    <RadioButton Grid.Column="1" Style="{StaticResource SegmentButton}"
                                                 Content="Vừa" IsChecked="{Binding IsMedium}" GroupName="AiDiffMenu" />
                                    <RadioButton Grid.Column="2" Style="{StaticResource SegmentButton}"
                                                 Content="Khó" IsChecked="{Binding IsHard}" GroupName="AiDiffMenu" />
                                </Grid>

                                <!-- Luật Chơi -->
                                <TextBlock Text="LUẬT CHIẾN THẮNG" FontSize="11" FontWeight="Bold" Foreground="#9E9C99" Margin="2,0,0,6" />
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <RadioButton Grid.Column="0" Style="{StaticResource SegmentButton}"
                                                 Content="Chặn 2 đầu" IsChecked="{Binding IsVietnameseRule}" GroupName="RuleMenuAi" />
                                    <RadioButton Grid.Column="1" Style="{StaticResource SegmentButton}"
                                                 Content="Tự do" IsChecked="{Binding IsFreeRule}" GroupName="RuleMenuAi" />
                                </Grid>

                                <!-- Timer Toggle -->
                                <Border Background="#262421" BorderBrush="#3F3C38" BorderThickness="1"
                                        CornerRadius="8" Padding="12,8">
                                    <CheckBox Content="Giới hạn 30s mỗi lượt" IsChecked="{Binding EnableTimer}" />
                                </Border>
                            </StackPanel>

                            <!-- Play Button (Chess.com Green #81B64C) -->
                            <Button Grid.Row="2" Style="{StaticResource PrimaryButton}"
                                    Content="▶ CHƠI VỚI ROBOT" Command="{Binding StartPvCCommand}"
                                    FontSize="14" Padding="0,13" HorizontalAlignment="Stretch" />
                        </Grid>
                    </Border>

                    <!-- CARD 2: ĐẤU ONLINE (Multiplayer - Center Highlight) -->
                    <Border Grid.Column="2" Background="#302E2B" BorderBrush="#4A5F78" BorderThickness="1.5"
                            CornerRadius="18" Padding="24,24">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="30" ShadowDepth="8" Direction="270" Color="#000000" Opacity="0.5" />
                        </Border.Effect>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Header -->
                            <StackPanel Grid.Row="0" Margin="0,0,0,16">
                                <Grid>
                                    <Border Width="52" Height="52" CornerRadius="14" Background="#1B2B3A" BorderBrush="#2A4866" BorderThickness="1"
                                            HorizontalAlignment="Left" Margin="0,0,0,12">
                                        <TextBlock Text="🌐" FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <Border Background="#3B82F6" CornerRadius="6" Padding="6,2" HorizontalAlignment="Right" VerticalAlignment="Top">
                                        <TextBlock Text="MULTIPLAYER" FontWeight="Black" FontSize="9.5" Foreground="#FFFFFF" />
                                    </Border>
                                </Grid>
                                <TextBlock Text="ĐẤU TRỰC TUYẾN" FontSize="18" FontWeight="Black" Foreground="#FFFFFF" />
                                <TextBlock Text="Đấu đối kháng thời gian thực &amp; leo Rank Elo" FontSize="12.5" Foreground="#9E9C99" Margin="0,4,0,0" />
                            </StackPanel>

                            <!-- Feature list -->
                            <StackPanel Grid.Row="1" Margin="0,0,0,20">
                                <Border Background="#262421" BorderBrush="#3F3C38" BorderThickness="1"
                                        CornerRadius="10" Padding="14,12" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="⚡ Ghép phòng nhanh qua mã 6 số" FontSize="12.5" Foreground="#D6D3CD" FontWeight="SemiBold" Margin="0,0,0,6" />
                                        <TextBlock Text="⭐ Tính điểm Elo chuẩn Chess.com" FontSize="12.5" Foreground="#D6D3CD" FontWeight="SemiBold" Margin="0,0,0,6" />
                                        <TextBlock Text="💬 Trò chuyện Chat trực tiếp trong trận" FontSize="12.5" Foreground="#D6D3CD" FontWeight="SemiBold" Margin="0,0,0,6" />
                                        <TextBlock Text="⏱️ Đồng hồ đếm ngược 30 giây kịch tính" FontSize="12.5" Foreground="#D6D3CD" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Border>

                                <Border Background="#21201D" BorderBrush="#36332E" BorderThickness="1" CornerRadius="8" Padding="10,6">
                                    <TextBlock Text="💡 Cần có tài khoản để lưu điểm vào Bảng Xếp Hạng"
                                               FontSize="11" Foreground="#9E9C99" TextWrapping="Wrap" />
                                </Border>
                            </StackPanel>

                            <!-- Online Button (Chess.com Blue #387BB6) -->
                            <Button Grid.Row="2" Style="{StaticResource AccentBlueButton}"
                                    Content="🌐 VÀO SẢNH ONLINE" Command="{Binding OpenOnlineLobbyCommand}"
                                    FontSize="14" Padding="0,13" HorizontalAlignment="Stretch" />
                        </Grid>
                    </Border>

                    <!-- CARD 3: 2 NGƯỜI CHƠI (Pass & Play) -->
                    <Border Grid.Column="4" Background="#302E2B" BorderBrush="#3F3C38" BorderThickness="1.5"
                            CornerRadius="18" Padding="24,24">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="25" ShadowDepth="6" Direction="270" Color="#000000" Opacity="0.4" />
                        </Border.Effect>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Header -->
                            <StackPanel Grid.Row="0" Margin="0,0,0,16">
                                <Border Width="52" Height="52" CornerRadius="14" Background="#262421" BorderBrush="#3F3C38" BorderThickness="1"
                                        HorizontalAlignment="Left" Margin="0,0,0,12">
                                    <TextBlock Text="👥" FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="2 NGƯỜI CHƠI" FontSize="18" FontWeight="Black" Foreground="#FFFFFF" />
                                <TextBlock Text="Cùng chơi trên 1 màn hình máy tính" FontSize="12.5" Foreground="#9E9C99" Margin="0,4,0,0" />
                            </StackPanel>

                            <!-- Options -->
                            <StackPanel Grid.Row="1" Margin="0,0,0,20">
                                <!-- Luật Chơi -->
                                <TextBlock Text="LUẬT CHIẾN THẮNG" FontSize="11" FontWeight="Bold" Foreground="#9E9C99" Margin="2,0,0,6" />
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <RadioButton Grid.Column="0" Style="{StaticResource SegmentButton}"
                                                 Content="Chặn 2 đầu" IsChecked="{Binding IsVietnameseRule}" GroupName="RuleMenuPvp" />
                                    <RadioButton Grid.Column="1" Style="{StaticResource SegmentButton}"
                                                 Content="Tự do" IsChecked="{Binding IsFreeRule}" GroupName="RuleMenuPvp" />
                                </Grid>

                                <!-- Timer Toggle -->
                                <Border Background="#262421" BorderBrush="#3F3C38" BorderThickness="1"
                                        CornerRadius="8" Padding="12,8" Margin="0,0,0,14">
                                    <CheckBox Content="Giới hạn 30s mỗi lượt" IsChecked="{Binding EnableTimer}" />
                                </Border>

                                <TextBlock Text="Chế độ ngoại tuyến thích hợp khi chơi cùng bạn bè hoặc người thân."
                                           FontSize="11.5" Foreground="#75736F" TextWrapping="Wrap" />
                            </StackPanel>

                            <!-- Play 2 Player Button -->
                            <Button Grid.Row="2"
                                    Content="👥 CHƠI 2 NGƯỜI TẠI CHỖ" Command="{Binding StartPvPCommand}"
                                    FontSize="14" Padding="0,13" HorizontalAlignment="Stretch" />
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </ScrollViewer>

        <!-- FOOTER: Version info -->
        <Border Grid.Row="2" Background="#21201D" BorderBrush="#36332E" BorderThickness="0,1,0,0" Padding="28,8">
            <Grid>
                <TextBlock Text="Cờ Caro Vô Hạn (.NET 9 WPF) • Bàn cờ vô tận Pan &amp; Zoom"
                           FontSize="11.5" Foreground="#75736F" HorizontalAlignment="Left" />
                <TextBlock Text="Minimax Alpha-Beta Engine • SignalR Real-Time Multiplayer"
                           FontSize="11.5" Foreground="#75736F" HorizontalAlignment="Right" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
