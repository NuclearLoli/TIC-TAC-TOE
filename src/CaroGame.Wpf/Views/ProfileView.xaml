<UserControl x:Class="CaroGame.Wpf.Views.ProfileView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:conv="clr-namespace:CaroGame.Wpf.Converters"
             xmlns:controls="clr-namespace:CaroGame.Wpf.Controls"
             xmlns:vm="clr-namespace:CaroGame.Wpf.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:ProfileViewModel}">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
        <conv:BoolToVisibilityConverter x:Key="InvertedBoolToVis" Invert="True" />
        <conv:StringEqualsConverter x:Key="StringEqualsConverter" />
    </UserControl.Resources>

    <Grid Background="#262421">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- TOP BAR -->
        <Border Grid.Row="0" Background="#21201D" BorderBrush="#36332E" BorderThickness="0,0,0,1" Padding="24,10">
            <Grid>
                <Button Content="← Quay lại" Command="{Binding BackCommand}"
                        HorizontalAlignment="Left" VerticalAlignment="Center"
                        Padding="14,8" Background="#302E2B" BorderBrush="#3F3C38" Foreground="#C3C1BE" />

                <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="Black"
                           Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="👥 Bạn Bè" Command="{Binding OpenFriendsCommand}"
                            Padding="12,7" Background="#302E2B" BorderBrush="#3F3C38" Foreground="#C3C1BE" Margin="0,0,8,0" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- CONTENT SCROLLVIEWER -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel MaxWidth="820" HorizontalAlignment="Center" Margin="24,20,24,32">

                <!-- FEEDBACK BANNERS -->
                <Border CornerRadius="8" Padding="14,9" Margin="0,0,0,14"
                        Background="#1E3326" BorderBrush="#2D5A3E" BorderThickness="1"
                        Visibility="{Binding HasSuccess, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding SuccessMessage}" FontSize="12.5" Foreground="#4ADE80" FontWeight="Bold" HorizontalAlignment="Center" />
                </Border>

                <Border CornerRadius="8" Padding="14,9" Margin="0,0,0,14"
                        Background="#3D2424" BorderBrush="#613232" BorderThickness="1"
                        Visibility="{Binding HasStatus, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding StatusMessage}" FontSize="12.5" Foreground="#FFA3A3" FontWeight="Bold" HorizontalAlignment="Center" />
                </Border>

                <!-- HEADER PROFILE HERO CARD (Chess.com Style) -->
                <Border Background="#302E2B" BorderBrush="#3F3C38" BorderThickness="1.5"
                        CornerRadius="16" Padding="28,22" Margin="0,0,0,18">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="25" ShadowDepth="6" Direction="270" Color="#000000" Opacity="0.4" />
                    </Border.Effect>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Big Avatar with Dynamic Frame Ring -->
                        <controls:AvatarControl Grid.Column="0"
                                                Avatar="{Binding Profile.Avatar}"
                                                AvatarIcon="{Binding Profile.AvatarIcon}"
                                                Size="86" FontSize="44"
                                                BorderBrush="{Binding Profile.AvatarFrameBorderBrush}" BorderThickness="3.5"
                                                Margin="0,0,22,0" VerticalAlignment="Center" />

                        <!-- User Info -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <WrapPanel VerticalAlignment="Center" Margin="0,0,0,6">
                                <TextBlock Text="{Binding Profile.CountryFlag}" FontSize="16" Margin="0,0,8,4" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Profile.DisplayName}" FontSize="22" FontWeight="Black"
                                           Foreground="#FFFFFF" VerticalAlignment="Center" Margin="0,0,10,4" />
                                
                                <!-- Player Title Badge -->
                                <Border Background="#1C2E3D" BorderBrush="#38BDF8" BorderThickness="1"
                                        CornerRadius="6" Padding="8,2" VerticalAlignment="Center" Margin="0,0,6,4">
                                    <TextBlock Text="{Binding Profile.Title, StringFormat='⚔️ {0}'}" FontWeight="Bold" FontSize="11" Foreground="#38BDF8" />
                                </Border>

                                <!-- Rank Tier -->
                                <Border Background="#3B3220" BorderBrush="#78591E" BorderThickness="1"
                                        CornerRadius="6" Padding="8,2" VerticalAlignment="Center" Margin="0,0,6,4">
                                    <TextBlock Text="{Binding Profile.RankTier}" FontWeight="Bold" FontSize="11" Foreground="#F59E0B" />
                                </Border>

                                <!-- Email Verified Badge -->
                                <Border Background="#1E3326" BorderBrush="#2D5A3E" BorderThickness="1"
                                        CornerRadius="6" Padding="6,2" VerticalAlignment="Center" Margin="0,0,0,4">
                                    <TextBlock Text="✓ Verified" FontWeight="SemiBold" FontSize="10" Foreground="#4ADE80" />
                                </Border>
                            </WrapPanel>

                            <TextBlock Text="{Binding Profile.Username, StringFormat='@{0}'}"
                                       FontSize="13" Foreground="#9E9C99" Margin="0,0,0,6" />

                            <!-- Level & XP Progress Bar -->
                            <StackPanel Margin="0,0,0,8" Width="300" HorizontalAlignment="Left">
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Profile.Level, StringFormat='⚡ CẤP ĐỘ {0}'}" FontSize="11.5" FontWeight="Black" Foreground="#81B64C" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" FontSize="10.5" FontWeight="SemiBold" Foreground="#9E9C99" VerticalAlignment="Center">
                                        <Run Text="{Binding Profile.CurrentLevelXp, Mode=OneWay}" />
                                        <Run Text=" / " />
                                        <Run Text="{Binding Profile.NextLevelXp, Mode=OneWay}" />
                                        <Run Text=" XP" />
                                    </TextBlock>
                                </Grid>
                                <ProgressBar Value="{Binding Profile.XpProgressPercentage, Mode=OneWay}" Maximum="100" Height="6"
                                             Background="#21201D" Foreground="#81B64C" BorderThickness="0" />
                            </StackPanel>

                            <Border Background="#262421" CornerRadius="8" Padding="10,6" Margin="0,0,0,4" HorizontalAlignment="Left">
                                <TextBlock Text="{Binding Profile.Bio}" FontSize="12.5" Foreground="#D6D3CD" FontStyle="Italic" TextWrapping="Wrap" />
                            </Border>

                            <TextBlock Text="{Binding Profile.CreatedAt, StringFormat='Thành viên từ: {0:dd/MM/yyyy}'}"
                                       FontSize="11" Foreground="#787570" Margin="2,4,0,0" />
                        </StackPanel>

                        <!-- Actions for other players -->
                        <StackPanel Grid.Column="2" VerticalAlignment="Center"
                                    Visibility="{Binding IsMyProfile, Converter={StaticResource InvertedBoolToVis}}">
                            <Button Content="➕ KẾT BẠN" Command="{Binding AddFriendCommand}"
                                    Style="{StaticResource PrimaryButton}" Padding="16,8" Margin="0,0,0,8" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- TAB SWITCHER (For My Profile) -->
                <Border Background="#302E2B" CornerRadius="10" Padding="4" Margin="0,0,0,18"
                        Visibility="{Binding IsMyProfile, Converter={StaticResource BoolToVis}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" Content="📊 THỐNG KÊ CHIẾN TÍCH" Command="{Binding SwitchTabCommand}" CommandParameter="Overview"
                                Height="36" Margin="2,0" FontWeight="Bold" FontSize="12.5">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="Foreground" Value="#9E9C99" />
                                    <Setter Property="BorderThickness" Value="0" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsOverviewTab}" Value="True">
                                            <Setter Property="Background" Value="#45423E" />
                                            <Setter Property="Foreground" Value="#FFFFFF" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Button Grid.Column="1" Content="🎨 TÙY BIẾN TÀI KHOẢN" Command="{Binding SwitchTabCommand}" CommandParameter="Edit"
                                Height="36" Margin="2,0" FontWeight="Bold" FontSize="12.5">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="Foreground" Value="#9E9C99" />
                                    <Setter Property="BorderThickness" Value="0" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsEditTab}" Value="True">
                                            <Setter Property="Background" Value="#45423E" />
                                            <Setter Property="Foreground" Value="#FFFFFF" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>
                </Border>

                <!-- ==================== TAB 1: OVERVIEW STATS ==================== -->
                <StackPanel Visibility="{Binding IsOverviewTab, Converter={StaticResource BoolToVis}}">
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="14" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="14" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Card 1: Elo Rating -->
                        <Border Grid.Row="0" Grid.Column="0" Background="#302E2B" BorderBrush="#3F3C38" BorderThickness="1"
                                CornerRadius="12" Padding="20,16">
                            <StackPanel>
                                <TextBlock Text="ĐIỂM XẾP HẠNG ELO" FontSize="11" FontWeight="Bold" Foreground="#9E9C99" Margin="0,0,0,6" />
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="⭐ " FontSize="20" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Profile.EloRating}" FontSize="28" FontWeight="Black" Foreground="#F59E0B" Margin="0,0,12,0" />
                                    <Border Background="#262421" CornerRadius="6" Padding="6,2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Profile.PeakElo, StringFormat='Kỷ lục: {0}'}" FontSize="11" Foreground="#9E9C99" />
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Card 2: Win Rate -->
                        <Border Grid.Row="0" Grid.Column="2" Background="#302E2B" BorderBrush="#3F3C38" BorderThickness="1"
                                CornerRadius="12" Padding="20,16">
                            <StackPanel>
                                <TextBlock Text="TỈ LỆ THẮNG" FontSize="11" FontWeight="Bold" Foreground="#9E9C99" Margin="0,0,0,6" />
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="🎯 " FontSize="20" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Profile.WinRate, StringFormat='{}{0}%'}" FontSize="28" FontWeight="Black" Foreground="#81B64C" Margin="0,0,12,0" />
                                    <TextBlock Text="{Binding Profile.TotalMatches, StringFormat='({0} trận)'}" FontSize="12" Foreground="#9E9C99" VerticalAlignment="Center" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Card 3: Match Results Breakdown -->
                        <Border Grid.Row="2" Grid.Column="0" Background="#302E2B" BorderBrush="#3F3C38" BorderThickness="1"
                                CornerRadius="12" Padding="20,16">
                            <StackPanel>
                                <TextBlock Text="KẾT QUẢ ĐỐI ĐẦU" FontSize="11" FontWeight="Bold" Foreground="#9E9C99" Margin="0,0,8,0" />
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Profile.Wins, StringFormat='{}🟢 Thắng: {0}'}" FontWeight="Bold" FontSize="13" Foreground="#4ADE80" Margin="0,0,12,0" />
                                    <TextBlock Text="{Binding Profile.Losses, StringFormat='{}🔴 Thua: {0}'}" FontWeight="Bold" FontSize="13" Foreground="#F87171" Margin="0,0,12,0" />
                                    <TextBlock Text="{Binding Profile.Draws, StringFormat='{}⚪ Hòa: {0}'}" FontWeight="Bold" FontSize="13" Foreground="#C3C1BE" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Card 4: Streaks -->
                        <Border Grid.Row="2" Grid.Column="2" Background="#302E2B" BorderBrush="#3F3C38" BorderThickness="1"
                                CornerRadius="12" Padding="20,16">
                            <StackPanel>
                                <TextBlock Text="CHUỖI THẮNG" FontSize="11" FontWeight="Bold" Foreground="#9E9C99" Margin="0,0,8,0" />
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Profile.WinStreak, StringFormat='{}🔥 Hiện tại: {0}'}" FontWeight="Bold" FontSize="13" Foreground="#F97316" Margin="0,0,14,0" />
                                    <TextBlock Text="{Binding Profile.BestWinStreak, StringFormat='{}🏆 Kỷ lục: {0}'}" FontWeight="Bold" FontSize="13" Foreground="#FACC15" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Card 5: Lowest Elo -->
                        <Border Grid.Row="4" Grid.Column="0" Background="#302E2B" BorderBrush="#3F3C38" BorderThickness="1"
                                CornerRadius="12" Padding="20,16">
                            <StackPanel>
                                <TextBlock Text="ELO THẤP NHẤT" FontSize="11" FontWeight="Bold" Foreground="#9E9C99" Margin="0,0,6,0" />
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="📉 " FontSize="18" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Profile.LowestElo}" FontSize="24" FontWeight="Black" Foreground="#C3C1BE" Margin="0,0,10,0" />
                                    <TextBlock Text="điểm" FontSize="12" Foreground="#787570" VerticalAlignment="Center" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Card 6: Play Time -->
                        <Border Grid.Row="4" Grid.Column="2" Background="#302E2B" BorderBrush="#3F3C38" BorderThickness="1"
                                CornerRadius="12" Padding="20,16">
                            <StackPanel>
                                <TextBlock Text="TỔNG THỜI GIAN THI ĐẤU" FontSize="11" FontWeight="Bold" Foreground="#9E9C99" Margin="0,0,6,0" />
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="⏱️ " FontSize="18" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Profile.FormattedPlayTime}" FontSize="24" FontWeight="Black" Foreground="#38BDF8" Margin="0,0,10,0" />
                                    <TextBlock Text="thi đấu thực tế" FontSize="12" Foreground="#787570" VerticalAlignment="Center" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>

                <!-- ==================== TAB 2: EDIT PROFILE & AVATAR ==================== -->
                <StackPanel Visibility="{Binding IsEditTab, Converter={StaticResource BoolToVis}}">
                    <Border Background="#302E2B" BorderBrush="#3F3C38" BorderThickness="1" CornerRadius="14" Padding="26,22">
                        <StackPanel>
                            <!-- LIVE PROFILE PREVIEW CARD (Chess.com Style) -->
                            <Border Background="#262421" BorderBrush="#3F3C38" BorderThickness="1" CornerRadius="12" Padding="18,14" Margin="0,0,0,20">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Live Preview Avatar with dynamic border frame -->
                                    <controls:AvatarControl Grid.Column="0"
                                                            Avatar="{Binding EditAvatar}"
                                                            AvatarIcon="{Binding PreviewAvatarIcon}"
                                                            Size="72" FontSize="36"
                                                            BorderBrush="{Binding PreviewAvatarFrameBorderBrush}"
                                                            BorderThickness="3"
                                                            Margin="0,0,18,0" VerticalAlignment="Center" />

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="XEM TRƯỚC HỒ SƠ THỰC TẾ (LIVE PREVIEW)" FontSize="10.5" FontWeight="Bold" Foreground="#81B64C" Margin="0,0,0,4" />
                                        <WrapPanel VerticalAlignment="Center" Margin="0,0,0,4">
                                            <TextBlock Text="{Binding PreviewCountryFlag}" FontSize="15" Margin="0,0,6,2" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding EditDisplayName}" FontSize="18" FontWeight="Black" Foreground="#FFFFFF" Margin="0,0,8,2" VerticalAlignment="Center" />
                                            <Border Background="#1C2E3D" BorderBrush="#38BDF8" BorderThickness="1"
                                                    CornerRadius="6" Padding="7,2" VerticalAlignment="Center" Margin="0,0,6,2">
                                                <TextBlock Text="{Binding EditTitle, StringFormat='⚔️ {0}'}" FontWeight="Bold" FontSize="11" Foreground="#38BDF8" />
                                            </Border>
                                        </WrapPanel>
                                        <TextBlock Text="{Binding EditBio}" FontSize="12" Foreground="#9E9C99" FontStyle="Italic" TextWrapping="Wrap" MaxHeight="38" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Custom Avatar Upload Card -->
                            <Border Background="#262421" BorderBrush="#3F3C38" BorderThickness="1" CornerRadius="12" Padding="18,14" Margin="0,0,0,18">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Small avatar helper preview -->
                                    <controls:AvatarControl Grid.Column="0"
                                                            Avatar="{Binding EditAvatar}"
                                                            AvatarIcon="{Binding PreviewAvatarIcon}"
                                                            Size="54" FontSize="26"
                                                            BorderBrush="#81B64C" BorderThickness="2"
                                                            Margin="0,0,16,0" VerticalAlignment="Center" />

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="ẢNH ĐẠI DIỆN TÙY CHỈNH (TỰ DO UPLOAD TỪ MÁY)" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,4" />
                                        <TextBlock Text="Tự do tải ảnh đại diện từ máy tính của bạn (JPG, PNG, WEBP). Hệ thống tự động nén tối ưu."
                                                   FontSize="11.5" Foreground="#9E9C99" Margin="0,0,0,10" TextWrapping="Wrap" />

                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="📁 Tải Ảnh Từ Máy Tính..."
                                                    Command="{Binding UploadCustomAvatarCommand}"
                                                    Style="{StaticResource AccentBlueButton}"
                                                    Padding="14,7" Margin="0,0,10,0"
                                                    ToolTip="Chọn một tệp ảnh trên máy tính của bạn" />

                                            <Button Content="❌ Dùng icon mặc định"
                                                    Command="{Binding RemoveCustomAvatarCommand}"
                                                    Visibility="{Binding HasCustomAvatar, Converter={StaticResource BoolToVis}}"
                                                    Background="#3F2727" Foreground="#EF4444" BorderBrush="#7F1D1D" BorderThickness="1"
                                                    Padding="12,7" ToolTip="Quay về sử dụng bộ icon cờ mặc định">
                                                <Button.Resources>
                                                    <Style TargetType="Border">
                                                        <Setter Property="CornerRadius" Value="8" />
                                                    </Style>
                                                </Button.Resources>
                                            </Button>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <TextBlock Text="HOẶC CHỌN ICON CÓ SẴN (CHESS.COM STYLE)" FontSize="12" FontWeight="Bold" Foreground="#81B64C" Margin="0,0,0,10" />

                            <!-- 10 Avatar Choices in Grid -->
                            <WrapPanel Margin="0,0,0,20">
                                <RadioButton Style="{StaticResource SegmentButton}" GroupName="AvatarGroup" Margin="4"
                                             IsChecked="{Binding EditAvatar, Converter={StaticResource StringEqualsConverter}, ConverterParameter=king, Mode=TwoWay}">
                                    <StackPanel Orientation="Horizontal" Margin="4,2">
                                        <TextBlock Text="👑" FontSize="18" Margin="0,0,6,0" />
                                        <TextBlock Text="Vua Cờ" FontWeight="Bold" FontSize="12" VerticalAlignment="Center" />
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton Style="{StaticResource SegmentButton}" GroupName="AvatarGroup" Margin="4"
                                             IsChecked="{Binding EditAvatar, Converter={StaticResource StringEqualsConverter}, ConverterParameter=knight, Mode=TwoWay}">
                                    <StackPanel Orientation="Horizontal" Margin="4,2">
                                        <TextBlock Text="⚔️" FontSize="18" Margin="0,0,6,0" />
                                        <TextBlock Text="Hiệp Sĩ" FontWeight="Bold" FontSize="12" VerticalAlignment="Center" />
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton Style="{StaticResource SegmentButton}" GroupName="AvatarGroup" Margin="4"
                                             IsChecked="{Binding EditAvatar, Converter={StaticResource StringEqualsConverter}, ConverterParameter=ninja, Mode=TwoWay}">
                                    <StackPanel Orientation="Horizontal" Margin="4,2">
                                        <TextBlock Text="🥷" FontSize="18" Margin="0,0,6,0" />
                                        <TextBlock Text="Ninja" FontWeight="Bold" FontSize="12" VerticalAlignment="Center" />
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton Style="{StaticResource SegmentButton}" GroupName="AvatarGroup" Margin="4"
                                             IsChecked="{Binding EditAvatar, Converter={StaticResource StringEqualsConverter}, ConverterParameter=bot, Mode=TwoWay}">
                                    <StackPanel Orientation="Horizontal" Margin="4,2">
                                        <TextBlock Text="🤖" FontSize="18" Margin="0,0,6,0" />
                                        <TextBlock Text="Cyber Bot" FontWeight="Bold" FontSize="12" VerticalAlignment="Center" />
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton Style="{StaticResource SegmentButton}" GroupName="AvatarGroup" Margin="4"
                                             IsChecked="{Binding EditAvatar, Converter={StaticResource StringEqualsConverter}, ConverterParameter=fox, Mode=TwoWay}">
                                    <StackPanel Orientation="Horizontal" Margin="4,2">
                                        <TextBlock Text="🦊" FontSize="18" Margin="0,0,6,0" />
                                        <TextBlock Text="Cáo Tinh Anh" FontWeight="Bold" FontSize="12" VerticalAlignment="Center" />
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton Style="{StaticResource SegmentButton}" GroupName="AvatarGroup" Margin="4"
                                             IsChecked="{Binding EditAvatar, Converter={StaticResource StringEqualsConverter}, ConverterParameter=cat, Mode=TwoWay}">
                                    <StackPanel Orientation="Horizontal" Margin="4,2">
                                        <TextBlock Text="🐱" FontSize="18" Margin="0,0,6,0" />
                                        <TextBlock Text="Mèo Hiệp" FontWeight="Bold" FontSize="12" VerticalAlignment="Center" />
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton Style="{StaticResource SegmentButton}" GroupName="AvatarGroup" Margin="4"
                                             IsChecked="{Binding EditAvatar, Converter={StaticResource StringEqualsConverter}, ConverterParameter=dragon, Mode=TwoWay}">
                                    <StackPanel Orientation="Horizontal" Margin="4,2">
                                        <TextBlock Text="🐉" FontSize="18" Margin="0,0,6,0" />
                                        <TextBlock Text="Hỏa Long" FontWeight="Bold" FontSize="12" VerticalAlignment="Center" />
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton Style="{StaticResource SegmentButton}" GroupName="AvatarGroup" Margin="4"
                                             IsChecked="{Binding EditAvatar, Converter={StaticResource StringEqualsConverter}, ConverterParameter=lightning, Mode=TwoWay}">
                                    <StackPanel Orientation="Horizontal" Margin="4,2">
                                        <TextBlock Text="⚡" FontSize="18" Margin="0,0,6,0" />
                                        <TextBlock Text="Lôi Thần" FontWeight="Bold" FontSize="12" VerticalAlignment="Center" />
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton Style="{StaticResource SegmentButton}" GroupName="AvatarGroup" Margin="4"
                                             IsChecked="{Binding EditAvatar, Converter={StaticResource StringEqualsConverter}, ConverterParameter=shield, Mode=TwoWay}">
                                    <StackPanel Orientation="Horizontal" Margin="4,2">
                                        <TextBlock Text="🛡️" FontSize="18" Margin="0,0,6,0" />
                                        <TextBlock Text="Hộ Vệ" FontWeight="Bold" FontSize="12" VerticalAlignment="Center" />
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton Style="{StaticResource SegmentButton}" GroupName="AvatarGroup" Margin="4"
                                             IsChecked="{Binding EditAvatar, Converter={StaticResource StringEqualsConverter}, ConverterParameter=star, Mode=TwoWay}">
                                    <StackPanel Orientation="Horizontal" Margin="4,2">
                                        <TextBlock Text="🌟" FontSize="18" Margin="0,0,6,0" />
                                        <TextBlock Text="Tân Tinh" FontWeight="Bold" FontSize="12" VerticalAlignment="Center" />
                                    </StackPanel>
                                </RadioButton>
                            </WrapPanel>

                            <!-- Country Flag Selector -->
                            <TextBlock Text="QUỐC KỲ / KHU VỰC" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,10" />
                            <WrapPanel Margin="0,0,0,20">
                                <RadioButton Content="🇻🇳 Việt Nam" Style="{StaticResource SegmentButton}" GroupName="CountryGroup" Margin="3"
                                             IsChecked="{Binding EditCountry, Converter={StaticResource StringEqualsConverter}, ConverterParameter=VN, Mode=TwoWay}" />
                                <RadioButton Content="🇯🇵 Nhật Bản" Style="{StaticResource SegmentButton}" GroupName="CountryGroup" Margin="3"
                                             IsChecked="{Binding EditCountry, Converter={StaticResource StringEqualsConverter}, ConverterParameter=JP, Mode=TwoWay}" />
                                <RadioButton Content="🇰🇷 Hàn Quốc" Style="{StaticResource SegmentButton}" GroupName="CountryGroup" Margin="3"
                                             IsChecked="{Binding EditCountry, Converter={StaticResource StringEqualsConverter}, ConverterParameter=KR, Mode=TwoWay}" />
                                <RadioButton Content="🇺🇸 Hoa Kỳ" Style="{StaticResource SegmentButton}" GroupName="CountryGroup" Margin="3"
                                             IsChecked="{Binding EditCountry, Converter={StaticResource StringEqualsConverter}, ConverterParameter=US, Mode=TwoWay}" />
                                <RadioButton Content="🇬🇧 Anh Quốc" Style="{StaticResource SegmentButton}" GroupName="CountryGroup" Margin="3"
                                             IsChecked="{Binding EditCountry, Converter={StaticResource StringEqualsConverter}, ConverterParameter=GB, Mode=TwoWay}" />
                                <RadioButton Content="🇫🇷 Pháp" Style="{StaticResource SegmentButton}" GroupName="CountryGroup" Margin="3"
                                             IsChecked="{Binding EditCountry, Converter={StaticResource StringEqualsConverter}, ConverterParameter=FR, Mode=TwoWay}" />
                                <RadioButton Content="🇩🇪 Đức" Style="{StaticResource SegmentButton}" GroupName="CountryGroup" Margin="3"
                                             IsChecked="{Binding EditCountry, Converter={StaticResource StringEqualsConverter}, ConverterParameter=DE, Mode=TwoWay}" />
                                <RadioButton Content="🌐 Quốc tế" Style="{StaticResource SegmentButton}" GroupName="CountryGroup" Margin="3"
                                             IsChecked="{Binding EditCountry, Converter={StaticResource StringEqualsConverter}, ConverterParameter=INT, Mode=TwoWay}" />
                            </WrapPanel>

                            <!-- Avatar Frame Selector -->
                            <TextBlock Text="KHUNG VIỀN AVATAR (AVATAR FRAME)" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,10" />
                            <WrapPanel Margin="0,0,0,16">
                                <RadioButton Content="🌿 Mặc định (Classic)" Style="{StaticResource SegmentButton}" GroupName="FrameGroup" Margin="3"
                                             IsChecked="{Binding EditAvatarFrame, Converter={StaticResource StringEqualsConverter}, ConverterParameter=classic, Mode=TwoWay}" />
                                <RadioButton Content="🥉 Đồng (Bronze)" Style="{StaticResource SegmentButton}" GroupName="FrameGroup" Margin="3"
                                             IsChecked="{Binding EditAvatarFrame, Converter={StaticResource StringEqualsConverter}, ConverterParameter=bronze, Mode=TwoWay}" />
                                <RadioButton Content="🥈 Bạc (Silver)" Style="{StaticResource SegmentButton}" GroupName="FrameGroup" Margin="3"
                                             IsChecked="{Binding EditAvatarFrame, Converter={StaticResource StringEqualsConverter}, ConverterParameter=silver, Mode=TwoWay}" />
                                <RadioButton Content="👑 Hoàng Kim (Gold)" Style="{StaticResource SegmentButton}" GroupName="FrameGroup" Margin="3"
                                             IsChecked="{Binding EditAvatarFrame, Converter={StaticResource StringEqualsConverter}, ConverterParameter=gold, Mode=TwoWay}" />
                                <RadioButton Content="💎 Kim Cương (Diamond)" Style="{StaticResource SegmentButton}" GroupName="FrameGroup" Margin="3"
                                             IsChecked="{Binding EditAvatarFrame, Converter={StaticResource StringEqualsConverter}, ConverterParameter=diamond, Mode=TwoWay}" />
                                <RadioButton Content="🔥 Thách Đấu (Challenger)" Style="{StaticResource SegmentButton}" GroupName="FrameGroup" Margin="3"
                                             IsChecked="{Binding EditAvatarFrame, Converter={StaticResource StringEqualsConverter}, ConverterParameter=challenger, Mode=TwoWay}" />
                            </WrapPanel>

                            <!-- Player Title Selector (Chess.com Flairs) -->
                            <TextBlock Text="DANH HIỆU KỲ THỦ (CHESS.COM TITLE &amp; FLAIR)" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,6" />
                            <TextBlock Text="Chọn danh hiệu vinh danh hoặc gõ danh hiệu tùy thích bên dưới:" FontSize="11" Foreground="#9E9C99" Margin="0,0,0,10" />
                            <WrapPanel Margin="0,0,0,12">
                                <RadioButton Content="🌱 Tân Thủ" Style="{StaticResource SegmentButton}" GroupName="TitleGroup" Margin="3"
                                             IsChecked="{Binding EditTitle, Converter={StaticResource StringEqualsConverter}, ConverterParameter='Tân Thủ', Mode=TwoWay}" />
                                <RadioButton Content="⚔️ Kỳ Thủ" Style="{StaticResource SegmentButton}" GroupName="TitleGroup" Margin="3"
                                             IsChecked="{Binding EditTitle, Converter={StaticResource StringEqualsConverter}, ConverterParameter='Kỳ Thủ', Mode=TwoWay}" />
                                <RadioButton Content="💎 Kiện Tướng" Style="{StaticResource SegmentButton}" GroupName="TitleGroup" Margin="3"
                                             IsChecked="{Binding EditTitle, Converter={StaticResource StringEqualsConverter}, ConverterParameter='Kiện Tướng', Mode=TwoWay}" />
                                <RadioButton Content="👑 Đại Kiện Tướng" Style="{StaticResource SegmentButton}" GroupName="TitleGroup" Margin="3"
                                             IsChecked="{Binding EditTitle, Converter={StaticResource StringEqualsConverter}, ConverterParameter='Đại Kiện Tướng', Mode=TwoWay}" />
                                <RadioButton Content="⚡ Chiến Thần" Style="{StaticResource SegmentButton}" GroupName="TitleGroup" Margin="3"
                                             IsChecked="{Binding EditTitle, Converter={StaticResource StringEqualsConverter}, ConverterParameter='Chiến Thần', Mode=TwoWay}" />
                                <RadioButton Content="🎯 Bậc Thầy Caro" Style="{StaticResource SegmentButton}" GroupName="TitleGroup" Margin="3"
                                             IsChecked="{Binding EditTitle, Converter={StaticResource StringEqualsConverter}, ConverterParameter='Bậc Thầy Caro', Mode=TwoWay}" />
                                <RadioButton Content="🏆 Bất Khả Chiến Bại" Style="{StaticResource SegmentButton}" GroupName="TitleGroup" Margin="3"
                                             IsChecked="{Binding EditTitle, Converter={StaticResource StringEqualsConverter}, ConverterParameter='Bất Khả Chiến Bại', Mode=TwoWay}" />
                                <RadioButton Content="☕ Giao Lưu Học Hỏi" Style="{StaticResource SegmentButton}" GroupName="TitleGroup" Margin="3"
                                             IsChecked="{Binding EditTitle, Converter={StaticResource StringEqualsConverter}, ConverterParameter='Giao Lưu Học Hỏi', Mode=TwoWay}" />
                            </WrapPanel>

                            <!-- Custom Title input -->
                            <TextBlock Text="HOẶC NHẬP DANH HIỆU TỰ ĐẶT (CUSTOM TITLE / FLAIR)" FontSize="11" FontWeight="Bold" Foreground="#81B64C" Margin="0,0,0,6" />
                            <TextBox Text="{Binding EditTitle, UpdateSourceTrigger=PropertyChanged}"
                                     MaxLength="30" FontSize="14" Height="42" VerticalContentAlignment="Center"
                                     Padding="12,0" Margin="0,0,0,16" />

                            <!-- DisplayName Input -->
                            <TextBlock Text="TÊN HIỂN THỊ TRONG GAME" FontSize="12" FontWeight="Bold" Foreground="#9E9C99" Margin="0,0,0,6" />
                            <TextBox Text="{Binding EditDisplayName, UpdateSourceTrigger=PropertyChanged}"
                                     MaxLength="32" FontSize="14" Height="42" VerticalContentAlignment="Center"
                                     Padding="12,0" Margin="0,0,0,16" />

                            <!-- Bio Input -->
                            <TextBlock Text="TIỂU SỬ / CHÂM NGÔN CÁ NHÂN" FontSize="12" FontWeight="Bold" Foreground="#9E9C99" Margin="0,0,0,6" />
                            <TextBox Text="{Binding EditBio, UpdateSourceTrigger=PropertyChanged}"
                                     MaxLength="200" FontSize="13.5" Height="68" TextWrapping="Wrap" AcceptsReturn="True"
                                     VerticalContentAlignment="Top" Padding="12,8" Margin="0,0,0,22" />

                            <!-- Save Button -->
                            <Button Content="💾 LƯU THAY ĐỔI HỒ SƠ" Command="{Binding SaveProfileCommand}"
                                    Style="{StaticResource PrimaryButton}" FontSize="14" Padding="0,12" Margin="0,0,0,16" />

                            <!-- Quick Link to Settings (Security & Password) -->
                            <Border Background="#262421" BorderBrush="#3F3C38" BorderThickness="1" CornerRadius="10" Padding="16,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="🛡️ Cài Đặt Mật Khẩu &amp; Liên Kết Email" FontWeight="Bold" FontSize="13" Foreground="#FFFFFF" />
                                        <TextBlock Text="Đổi mật khẩu tài khoản và liên kết email xác thực đã được chuyển sang trang Cài Đặt."
                                                   FontSize="11.5" Foreground="#9E9C99" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="Đi Đến Cài Đặt ⚙️" Command="{Binding OpenSecuritySettingsCommand}"
                                            Style="{StaticResource AccentBlueButton}" Padding="14,8" VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
