<UserControl x:Class="CaroGame.Wpf.Views.FriendsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:conv="clr-namespace:CaroGame.Wpf.Converters"
             xmlns:controls="clr-namespace:CaroGame.Wpf.Controls"
             xmlns:vm="clr-namespace:CaroGame.Wpf.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:FriendsViewModel}">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
        <conv:BoolToVisibilityConverter x:Key="InvertedBoolToVis" Invert="True" />
    </UserControl.Resources>

    <Grid Background="#262421">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- TOP BAR -->
        <Border Grid.Row="0" Background="#21201D" BorderBrush="#36332E" BorderThickness="0,0,0,1" Padding="24,10">
            <Grid>
                <Button Content="← Quay lại" Command="{Binding BackCommand}"
                        HorizontalAlignment="Left" VerticalAlignment="Center"
                        Padding="14,8" Background="#302E2B" BorderBrush="#3F3C38" Foreground="#C3C1BE" />

                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="👥 HỆ THỐNG BẠN BÈ" FontSize="18" FontWeight="Black"
                               Foreground="#FFFFFF" HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding OnlineFriendsCount, StringFormat='{}🟢 {0} bạn bè đang online'}"
                               FontSize="11.5" Foreground="#4ADE80" HorizontalAlignment="Center" Margin="0,2,0,0" />
                </StackPanel>

                <Button Content="🔄 Làm mới" Command="{Binding RefreshFriendsCommand}"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        Padding="12,7" Background="#302E2B" BorderBrush="#3F3C38" Foreground="#C3C1BE" />
            </Grid>
        </Border>

        <!-- MAIN CONTENT AREA -->
        <Grid Grid.Row="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel MaxWidth="820" HorizontalAlignment="Center" Margin="24,20,24,32">

                    <!-- FEEDBACK BANNERS -->
                    <Border CornerRadius="8" Padding="14,9" Margin="0,0,0,14"
                            Background="#1E3326" BorderBrush="#2D5A3E" BorderThickness="1"
                            Visibility="{Binding HasSuccess, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding SuccessMessage}" FontSize="12.5" Foreground="#4ADE80" FontWeight="Bold" HorizontalAlignment="Center" />
                    </Border>

                    <Border CornerRadius="8" Padding="14,9" Margin="0,0,0,14"
                            Background="#3D2424" BorderBrush="#613232" BorderThickness="1"
                            Visibility="{Binding HasStatus, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding StatusMessage}" FontSize="12.5" Foreground="#FFA3A3" FontWeight="Bold" HorizontalAlignment="Center" />
                    </Border>

                    <!-- TAB SELECTOR -->
                    <Border Background="#302E2B" CornerRadius="10" Padding="4" Margin="0,0,0,20">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0" Content="👥 DANH SÁCH BẠN BÈ" Command="{Binding SwitchTabCommand}" CommandParameter="Friends"
                                    Height="38" Margin="2,0" FontWeight="Bold" FontSize="12.5">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="Foreground" Value="#9E9C99" />
                                        <Setter Property="BorderThickness" Value="0" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsFriendsTab}" Value="True">
                                                <Setter Property="Background" Value="#45423E" />
                                                <Setter Property="Foreground" Value="#FFFFFF" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <!-- Requests Tab with Badge -->
                            <Button Grid.Column="1" Command="{Binding SwitchTabCommand}" CommandParameter="Requests"
                                    Height="38" Margin="2,0">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="Foreground" Value="#9E9C99" />
                                        <Setter Property="BorderThickness" Value="0" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsRequestsTab}" Value="True">
                                                <Setter Property="Background" Value="#45423E" />
                                                <Setter Property="Foreground" Value="#FFFFFF" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="📩 LỜI MỜI" FontWeight="Bold" FontSize="12.5" VerticalAlignment="Center" />
                                    <Border Background="#EF4444" CornerRadius="10" Padding="6,1" Margin="6,0,0,0"
                                            Visibility="{Binding PendingRequestsCount, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="{Binding PendingRequestsCount}" FontSize="10.5" FontWeight="Black" Foreground="#FFFFFF" />
                                    </Border>
                                </StackPanel>
                            </Button>

                            <Button Grid.Column="2" Content="🔍 TÌM BẠN MỚI" Command="{Binding SwitchTabCommand}" CommandParameter="Search"
                                    Height="38" Margin="2,0" FontWeight="Bold" FontSize="12.5">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="Foreground" Value="#9E9C99" />
                                        <Setter Property="BorderThickness" Value="0" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSearchTab}" Value="True">
                                                <Setter Property="Background" Value="#45423E" />
                                                <Setter Property="Foreground" Value="#FFFFFF" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- ==================== TAB 1: FRIENDS LIST ==================== -->
                    <StackPanel Visibility="{Binding IsFriendsTab, Converter={StaticResource BoolToVis}}">
                        <!-- Empty State -->
                        <Border Background="#302E2B" BorderBrush="#3F3C38" BorderThickness="1" CornerRadius="14" Padding="32"
                                Visibility="{Binding AcceptedFriends.Count, Converter={StaticResource InvertedBoolToVis}}">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="👥" FontSize="44" HorizontalAlignment="Center" Margin="0,0,0,8" />
                                <TextBlock Text="Bạn chưa có người bạn nào!" FontSize="15" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" />
                                <TextBlock Text="Chuyển sang tab 'TÌM BẠN MỚI' để tìm kiếm và gửi lời mời kết bạn!" FontSize="12" Foreground="#9E9C99" HorizontalAlignment="Center" Margin="0,4,0,16" />
                                <Button Content="🔍 Tìm bạn ngay" Command="{Binding SwitchTabCommand}" CommandParameter="Search"
                                        Style="{StaticResource PrimaryButton}" Padding="16,8" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <!-- Items List -->
                        <ItemsControl ItemsSource="{Binding AcceptedFriends}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#302E2B" BorderBrush="#3F3C38" BorderThickness="1"
                                            CornerRadius="12" Padding="18,14" Margin="0,0,0,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Avatar with Status Dot -->
                                            <Grid Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center">
                                                <controls:AvatarControl Avatar="{Binding Avatar}"
                                                                        AvatarIcon="{Binding AvatarIcon}"
                                                                        Size="46" FontSize="22"
                                                                        BorderBrush="#3F3C38" BorderThickness="1.5" />
                                            </Grid>

                                            <!-- Friend Details -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding CountryFlag}" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding DisplayName}" FontWeight="Bold" FontSize="14" Foreground="#FFFFFF" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                    <Border Background="#3B3220" BorderBrush="#78591E" BorderThickness="1" CornerRadius="5" Padding="6,1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding EloRating, StringFormat='⭐ {0} Elo'}" FontSize="11" FontWeight="Bold" Foreground="#F59E0B" />
                                                    </Border>
                                                </StackPanel>

                                                <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                    <TextBlock Text="{Binding Username, StringFormat='@{0}'}" FontSize="11.5" Foreground="#9E9C99" Margin="0,0,12,0" />
                                                    <TextBlock Text="{Binding StatusText}" FontSize="11.5" FontWeight="SemiBold">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="#8A8782" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsOnline}" Value="True">
                                                                        <Setter Property="Foreground" Value="#4ADE80" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>
                                            </StackPanel>

                                            <!-- Action Buttons -->
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Content="⚔️ Thách đấu"
                                                        Command="{Binding DataContext.ChallengeFriendCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource PrimaryButton}"
                                                        Padding="12,7" FontSize="12" Margin="0,0,8,0"
                                                        IsEnabled="{Binding IsOnline}" />

                                                <Button Content="👤 Hồ sơ"
                                                        Command="{Binding DataContext.ViewProfileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Padding="10,7" FontSize="12" Margin="0,0,8,0" />

                                                <Button Content="✕"
                                                        Command="{Binding DataContext.RemoveFriendCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource DangerButton}"
                                                        ToolTip="Hủy kết bạn"
                                                        Padding="8,7" FontSize="11" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- ==================== TAB 2: FRIEND REQUESTS ==================== -->
                    <StackPanel Visibility="{Binding IsRequestsTab, Converter={StaticResource BoolToVis}}">
                        <!-- Empty State -->
                        <Border Background="#302E2B" BorderBrush="#3F3C38" BorderThickness="1" CornerRadius="14" Padding="32"
                                Visibility="{Binding PendingRequests.Count, Converter={StaticResource InvertedBoolToVis}}">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="📬" FontSize="44" HorizontalAlignment="Center" Margin="0,0,0,8" />
                                <TextBlock Text="Không có lời mời kết bạn nào đang chờ!" FontSize="15" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" />
                                <TextBlock Text="Khi kỳ thủ khác gửi lời mời, bạn sẽ thấy thông báo tại đây." FontSize="12" Foreground="#9E9C99" HorizontalAlignment="Center" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>

                        <ItemsControl ItemsSource="{Binding PendingRequests}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#302E2B" BorderBrush="#3F3C38" BorderThickness="1"
                                            CornerRadius="12" Padding="18,14" Margin="0,0,0,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Avatar -->
                                            <controls:AvatarControl Grid.Column="0"
                                                                    Avatar="{Binding Avatar}"
                                                                    AvatarIcon="{Binding AvatarIcon}"
                                                                    Size="46" FontSize="22"
                                                                    BorderBrush="#3F3C38" BorderThickness="1.5"
                                                                    Margin="0,0,16,0" VerticalAlignment="Center" />

                                            <!-- Details -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding CountryFlag}" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding DisplayName}" FontWeight="Bold" FontSize="14" Foreground="#FFFFFF" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                    <Border Background="#3B3220" BorderBrush="#78591E" BorderThickness="1" CornerRadius="5" Padding="6,1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding EloRating, StringFormat='⭐ {0} Elo'}" FontSize="11" FontWeight="Bold" Foreground="#F59E0B" />
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Username, StringFormat='@{0}'}" FontSize="11.5" Foreground="#9E9C99" Margin="0,3,0,0" />
                                            </StackPanel>

                                            <!-- Accept / Decline Buttons -->
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Content="✅ Đồng ý"
                                                        Command="{Binding DataContext.AcceptRequestCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource PrimaryButton}"
                                                        Padding="12,7" FontSize="12" Margin="0,0,8,0" />

                                                <Button Content="❌ Từ chối"
                                                        Command="{Binding DataContext.DeclineRequestCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource DangerButton}"
                                                        Padding="12,7" FontSize="12" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- ==================== TAB 3: SEARCH USERS ==================== -->
                    <StackPanel Visibility="{Binding IsSearchTab, Converter={StaticResource BoolToVis}}">
                        <!-- Search Bar -->
                        <Border Background="#302E2B" BorderBrush="#3F3C38" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBox Grid.Column="0" Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                         FontSize="14" Height="42" VerticalContentAlignment="Center"
                                         Padding="12,0" />

                                <Button Grid.Column="2" Content="🔍 TÌM KIẾM" Command="{Binding SearchUsersCommand}"
                                        Style="{StaticResource AccentBlueButton}" Height="42" Padding="20,0" FontSize="13" />
                            </Grid>
                        </Border>

                        <!-- Results -->
                        <ItemsControl ItemsSource="{Binding SearchResults}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#302E2B" BorderBrush="#3F3C38" BorderThickness="1"
                                            CornerRadius="12" Padding="18,14" Margin="0,0,0,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <controls:AvatarControl Grid.Column="0"
                                                                    Avatar="{Binding Avatar}"
                                                                    AvatarIcon="{Binding AvatarIcon}"
                                                                    Size="46" FontSize="22"
                                                                    BorderBrush="#3F3C38" BorderThickness="1.5"
                                                                    Margin="0,0,16,0" VerticalAlignment="Center" />

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding CountryFlag}" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding DisplayName}" FontWeight="Bold" FontSize="14" Foreground="#FFFFFF" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                    <Border Background="#3B3220" BorderBrush="#78591E" BorderThickness="1" CornerRadius="5" Padding="6,1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding EloRating, StringFormat='⭐ {0} Elo'}" FontSize="11" FontWeight="Bold" Foreground="#F59E0B" />
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Username, StringFormat='@{0}'}" FontSize="11.5" Foreground="#9E9C99" Margin="0,3,0,0" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Content="➕ Gửi kết bạn"
                                                        Command="{Binding DataContext.SendFriendRequestCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource PrimaryButton}"
                                                        Padding="12,7" FontSize="12" Margin="0,0,8,0" />

                                                <Button Content="👤 Hồ sơ"
                                                        Command="{Binding DataContext.ViewSearchUserProfileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Padding="10,7" FontSize="12" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>

            <!-- CHALLENGE INVITATION MODAL DIALOG OVERLAY -->
            <Grid Background="#B3000000" Visibility="{Binding HasIncomingChallenge, Converter={StaticResource BoolToVis}}">
                <Border Width="450" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Background="#302E2B" BorderBrush="#81B64C" BorderThickness="2"
                        CornerRadius="16" Padding="32,26">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="40" ShadowDepth="10" Direction="270" Color="#000000" Opacity="0.7" />
                    </Border.Effect>

                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="⚔️ LỜI THÁCH ĐẤU TRỰC TUYẾN" FontSize="16" FontWeight="Black"
                                   Foreground="#F59E0B" HorizontalAlignment="Center" Margin="0,0,0,12" />

                        <controls:AvatarControl Avatar="{Binding IncomingChallenge.ChallengerAvatar}"
                                                AvatarIcon="{Binding IncomingChallenge.AvatarIcon}"
                                                Size="64" FontSize="32"
                                                BorderBrush="#F59E0B" BorderThickness="2"
                                                HorizontalAlignment="Center" Margin="0,0,0,12" />

                        <TextBlock Text="{Binding IncomingChallenge.ChallengerName}" FontSize="18" FontWeight="Black"
                                   Foreground="#FFFFFF" HorizontalAlignment="Center" Margin="0,0,0,4" />

                        <TextBlock Text="{Binding IncomingChallenge.ChallengerElo, StringFormat='⭐ {0} Elo'}" FontSize="13" FontWeight="Bold"
                                   Foreground="#F59E0B" HorizontalAlignment="Center" Margin="0,0,0,16" />

                        <TextBlock Text="Đang mời bạn thi đấu một ván cờ Caro thời gian thực!" FontSize="13"
                                   Foreground="#D6D3CD" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,0,0,24" />

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button Content="⚔️ CHẤP NHẬN &amp; VÀO TRẬN" Command="{Binding AcceptChallengeCommand}"
                                    Style="{StaticResource PrimaryButton}" Padding="18,10" FontSize="13.5" Margin="0,0,12,0" />
                            <Button Content="TỪ CHỐI" Command="{Binding DeclineChallengeCommand}"
                                    Style="{StaticResource DangerButton}" Padding="16,10" FontSize="13.5" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
