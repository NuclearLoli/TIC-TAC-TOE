<UserControl x:Class="CaroGame.Wpf.Views.LeaderboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:conv="clr-namespace:CaroGame.Wpf.Converters"
             xmlns:controls="clr-namespace:CaroGame.Wpf.Controls"
             xmlns:vm="clr-namespace:CaroGame.Wpf.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:LeaderboardViewModel}"
             d:DesignHeight="800" d:DesignWidth="1100">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Grid Background="#262421">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Top Navigation Bar -->
        <Border Grid.Row="0" Background="#1E1D1B" BorderBrush="#36332E" BorderThickness="0,0,0,1" Padding="28,14">
            <Border.Effect>
                <DropShadowEffect BlurRadius="12" Direction="270" ShadowDepth="2" Color="#000000" Opacity="0.4" />
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Back button -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="← Quay lại Lobby" Command="{Binding BackCommand}"
                            Padding="14,7" Margin="0,0,10,0" ToolTip="Trở về sảnh Online" />
                    <Button Content="🏠 Menu chính" Command="{Binding BackToMenuCommand}"
                            Padding="12,7" ToolTip="Trở về màn hình chính" />
                </StackPanel>

                <!-- Center Title -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="🏆" FontSize="20" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <TextBlock Text="BẢNG XẾP HẠNG CAO THỦ CARO" FontSize="18" FontWeight="Black"
                               Foreground="#FFFFFF" VerticalAlignment="Center" />
                </StackPanel>

                <!-- Refresh Button -->
                <Button Grid.Column="2" Content="🔄 Làm Mới" Command="{Binding RefreshCommand}"
                        Style="{StaticResource AccentBlueButton}" Padding="14,7" ToolTip="Tải lại bảng xếp hạng" />
            </Grid>
        </Border>

        <!-- Leaderboard Table Container -->
        <Border Grid.Row="1" Margin="32,20,32,16" Background="#302E2B" CornerRadius="16"
                BorderBrush="#3F3C38" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="24" ShadowDepth="4" Direction="270" Color="#000000" Opacity="0.4" />
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Table Header Row -->
                <Border Grid.Row="0" Background="#262421" CornerRadius="16,16,0,0" Padding="20,12"
                        BorderBrush="#36332E" BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="2.5*" />
                            <ColumnDefinition Width="1.5*" />
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="1.5*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="HẠNG" FontWeight="Bold" FontSize="11.5" Foreground="#9E9C99" HorizontalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="NGƯỜI CHƠI" FontWeight="Bold" FontSize="11.5" Foreground="#9E9C99" Margin="10,0,0,0" />
                        <TextBlock Grid.Column="2" Text="ĐIỂM ELO" FontWeight="Bold" FontSize="11.5" Foreground="#9E9C99" HorizontalAlignment="Center" />
                        <TextBlock Grid.Column="3" Text="THẮNG / THUA / HÒA" FontWeight="Bold" FontSize="11.5" Foreground="#9E9C99" HorizontalAlignment="Center" />
                        <TextBlock Grid.Column="4" Text="TỈ LỆ THẮNG" FontWeight="Bold" FontSize="11.5" Foreground="#9E9C99" HorizontalAlignment="Center" />
                    </Grid>
                </Border>

                <!-- Table Content List -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="12,6">
                    <ItemsControl ItemsSource="{Binding TopPlayers}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border CornerRadius="10" Padding="14,10" Margin="0,3">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#302E2B" />
                                            <Setter Property="BorderBrush" Value="#3F3C38" />
                                            <Setter Property="BorderThickness" Value="1" />
                                            <Style.Triggers>
                                                <!-- Current User highlight -->
                                                <DataTrigger Binding="{Binding IsCurrentUser}" Value="True">
                                                    <Setter Property="Background" Value="#1E3A5F" />
                                                    <Setter Property="BorderBrush" Value="#38BDF8" />
                                                    <Setter Property="BorderThickness" Value="1.5" />
                                                </DataTrigger>
                                                <!-- Top 1 highlight -->
                                                <DataTrigger Binding="{Binding Rank}" Value="1">
                                                    <Setter Property="Background" Value="#3A331E" />
                                                    <Setter Property="BorderBrush" Value="#B48220" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>

                                    <Grid VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="2.5*" />
                                            <ColumnDefinition Width="1.5*" />
                                            <ColumnDefinition Width="2*" />
                                            <ColumnDefinition Width="1.5*" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Rank Badge -->
                                        <Border Grid.Column="0" HorizontalAlignment="Center" CornerRadius="12" Padding="10,3">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#262421" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Rank}" Value="1">
                                                            <Setter Property="Background" Value="#78591E" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Rank}" Value="2">
                                                            <Setter Property="Background" Value="#4A4742" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Rank}" Value="3">
                                                            <Setter Property="Background" Value="#5C3B1E" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding RankDisplay}" FontWeight="Black" FontSize="13" Foreground="#FFFFFF" />
                                        </Border>

                                        <!-- Player Name, Avatar & Username -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <controls:AvatarControl Avatar="{Binding Avatar}"
                                                                        AvatarIcon="{Binding AvatarIcon}"
                                                                        Size="24" FontSize="12"
                                                                        BorderThickness="1"
                                                                        Margin="0,0,6,0" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding CountryFlag}" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding DisplayName}" FontWeight="Bold" FontSize="13.5" Foreground="#FFFFFF" VerticalAlignment="Center" />
                                                <Border Background="#81B64C" CornerRadius="4" Padding="5,1" Margin="8,0,0,0"
                                                        Visibility="{Binding IsCurrentUser, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="BẠN" FontWeight="Bold" FontSize="10" Foreground="#FFFFFF" />
                                                </Border>
                                                <Button Content="👤" Command="{Binding DataContext.ViewProfileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}" ToolTip="Xem hồ sơ"
                                                        Padding="6,2" FontSize="10.5" Margin="8,0,0,0" Cursor="Hand" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding Username, StringFormat='@{0}'}" FontSize="11.5" Foreground="#9E9C99" Margin="0,2,0,0" />
                                        </StackPanel>

                                        <!-- Elo Rating -->
                                        <Border Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                Background="#262421" BorderBrush="#3F3C38" BorderThickness="1" CornerRadius="8" Padding="10,4">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="⭐ " FontSize="12" Foreground="#F59E0B" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding EloRating}" FontWeight="Black" FontSize="14" Foreground="#F59E0B" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Border>

                                        <!-- Win / Loss / Draw stats -->
                                        <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Wins, StringFormat='{}{0}W'}" FontWeight="Bold" Foreground="#4ADE80" FontSize="13" Margin="0,0,6,0" />
                                            <TextBlock Text="•" Foreground="#5A554E" Margin="0,0,6,0" />
                                            <TextBlock Text="{Binding Losses, StringFormat='{}{0}L'}" FontWeight="Bold" Foreground="#EF4444" FontSize="13" Margin="0,0,6,0" />
                                            <TextBlock Text="•" Foreground="#5A554E" Margin="0,0,6,0" />
                                            <TextBlock Text="{Binding Draws, StringFormat='{}{0}D'}" FontWeight="Bold" Foreground="#9E9C99" FontSize="13" />
                                        </StackPanel>

                                        <!-- Win Rate -->
                                        <Border Grid.Column="4" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                Background="#1E3326" BorderBrush="#2D5A3E" BorderThickness="1" CornerRadius="8" Padding="8,3">
                                            <TextBlock Text="{Binding WinRate, StringFormat='{}{0}%'}" FontWeight="Bold" FontSize="12.5" Foreground="#4ADE80" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Bottom Bar: Status Message & User Personal Summary -->
        <Border Grid.Row="2" Background="#1E1D1B" BorderBrush="#36332E" BorderThickness="0,1,0,0" Padding="32,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" FontSize="12.5" Foreground="#9E9C99" VerticalAlignment="Center" />

                <!-- Current User Standing -->
                <Border Grid.Column="1" Background="#262421" BorderBrush="#3F3C38" BorderThickness="1"
                        CornerRadius="8" Padding="14,6" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="👤 " FontSize="13" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding MyRankText}" FontWeight="Bold" FontSize="12.5" Foreground="#FFFFFF" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
