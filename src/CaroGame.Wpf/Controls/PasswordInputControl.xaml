<UserControl x:Class="CaroGame.Wpf.Controls.PasswordInputControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             x:Name="RootControl"
             d:DesignHeight="42" d:DesignWidth="360">

    <UserControl.Resources>
        <Style x:Key="EyeButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder" Background="Transparent" CornerRadius="6"
                                Padding="6,2" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#22FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#33FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border x:Name="OuterBorder"
            Background="{Binding Background, ElementName=RootControl, FallbackValue='#1E1D1A'}"
            BorderBrush="{Binding BorderBrush, ElementName=RootControl, FallbackValue='#3F3C38'}"
            BorderThickness="{Binding BorderThickness, ElementName=RootControl, FallbackValue='1'}"
            CornerRadius="{Binding CornerRadius, ElementName=RootControl, FallbackValue='8'}"
            Height="{Binding Height, ElementName=RootControl, FallbackValue='42'}"
            SnapsToDevicePixels="True">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="42" />
            </Grid.ColumnDefinitions>

            <!-- Watermark / Placeholder -->
            <TextBlock x:Name="PlaceholderBlock"
                       Grid.Column="0"
                       Text="{Binding Placeholder, ElementName=RootControl}"
                       Foreground="#66635F"
                       FontSize="{Binding FontSize, ElementName=RootControl, FallbackValue='13.5'}"
                       VerticalAlignment="Center"
                       Margin="12,0,0,0"
                       IsHitTestVisible="False"
                       Visibility="Visible" />

            <!-- Masked PasswordBox (Default) -->
            <PasswordBox x:Name="InternalPasswordBox"
                         Grid.Column="0"
                         Background="Transparent"
                         BorderThickness="0"
                         Foreground="#FFFFFF"
                         FontSize="{Binding FontSize, ElementName=RootControl, FallbackValue='14'}"
                         VerticalContentAlignment="Center"
                         Padding="12,0,6,0"
                         PasswordChar="●"
                         CaretBrush="#81B64C"
                         PasswordChanged="InternalPasswordBox_PasswordChanged"
                         GotFocus="InputControl_GotFocus"
                         LostFocus="InputControl_LostFocus"
                         PreviewKeyDown="InternalPasswordBox_PreviewKeyDown" />

            <!-- Plain Text Box (When Eye is Toggled) -->
            <TextBox x:Name="InternalTextBox"
                     Grid.Column="0"
                     Background="Transparent"
                     BorderThickness="0"
                     Foreground="#FFFFFF"
                     FontSize="{Binding FontSize, ElementName=RootControl, FallbackValue='14'}"
                     VerticalContentAlignment="Center"
                     Padding="12,0,6,0"
                     CaretBrush="#81B64C"
                     Visibility="Collapsed"
                     TextChanged="InternalTextBox_TextChanged"
                     GotFocus="InputControl_GotFocus"
                     LostFocus="InputControl_LostFocus"
                     PreviewKeyDown="InternalTextBox_PreviewKeyDown" />

            <!-- Toggle Password Visibility Button (Eye Icon) -->
            <Button x:Name="ToggleVisibilityButton"
                    Grid.Column="1"
                    Style="{StaticResource EyeButtonStyle}"
                    Click="ToggleVisibilityButton_Click"
                    ToolTip="Hiện mật khẩu"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <TextBlock x:Name="EyeIconText"
                           Text="👁️"
                           FontSize="16"
                           Foreground="#9E9C99"
                           FontFamily="Segoe UI Emoji, Apple Color Emoji, Noto Color Emoji, Segoe UI Symbol, Segoe UI"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
            </Button>
        </Grid>
    </Border>
</UserControl>
